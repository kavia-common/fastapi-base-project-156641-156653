# Copy this file to .env and set values appropriately for your environment.

# REQUIRED: Secret key used to sign JWTs. Use a strong, random value.
JWT_SECRET=please-change-me-to-a-secure-random-string

# Optional: JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Optional: Access token expiration in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
